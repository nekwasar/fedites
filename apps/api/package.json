{
  "name": "@fedites/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude '**/*pg.test.ts'",
    "test:pg": "vitest run --no-file-parallelism src/phase1.pg.test.ts src/phase2.pg.test.ts src/phase2-ws.pg.test.ts src/phase3-events.pg.test.ts src/phase3-photos.pg.test.ts src/phase3-recognition.pg.test.ts src/phase4-money.pg.test.ts src/phase4-giving.pg.test.ts src/phase4-structured.pg.test.ts",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "7",
    "@fedites/config": "workspace:*",
    "@fedites/db": "workspace:*",
    "fastify": "^4.28.1",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/pg": "^8.11.6",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "@typescript-eslint/parser": "^8.2.0",
    "eslint": "^9.9.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vitest": "^2.0.5"
  }
}
